<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_leave_settlement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #333;">
                        <div class="text-center mb-4 mt-2">
                            <h3 style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">EthSwitch S.C.</h3>
                            <h4 style="font-weight: 600; color: #555; margin-top: 0;">Human Resources Department</h4>
                            <h5 style="text-decoration: underline; font-weight: 600; margin-top: 10px;">Annual Leave Settlement Statement</h5>
                        </div>

                        <!-- Employee Bio Data -->
                        <div class="row mb-4" style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 12px;">
                            <div class="col-6">
                                <p style="margin-bottom: 6px;"><strong>Employee Name:</strong> <span t-field="o.name"/></p>
                                <p style="margin-bottom: 6px;"><strong>Department:</strong> <span t-field="o.department_id.name"/></p>
                                <p style="margin-bottom: 6px;"><strong>Job Position:</strong> <span t-field="o.job_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p style="margin-bottom: 6px;"><strong>Employee Status:</strong> 
                                    <span t-if="o.active" class="badge badge-success" style="background-color: #28a745; color: white; padding: 3px 8px; border-radius: 3px;">Active</span>
                                    <span t-else="" class="badge badge-danger" style="background-color: #dc3545; color: white; padding: 3px 8px; border-radius: 3px;">Resigned / Terminated</span>
                                </p>
                                <p style="margin-bottom: 6px;"><strong>Employment Date:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/></p>
                                <p style="margin-bottom: 6px;"><strong>Date of Statement:</strong> <span t-esc="datetime.date.today().strftime('%B %d, %Y')"/></p>
                            </div>
                        </div>

                        <!-- Leave Balance Summary Table -->
                        <div class="mb-4">
                            <h6 style="font-weight: 700; border-bottom: 2px solid #0056b3; padding-bottom: 4px; color: #0056b3;">1. Leave Entitlement Summary</h6>
                            <table class="table table-bordered table-sm mt-2" style="width: 100%; border-collapse: collapse;">
                                <thead style="background-color: #e9ecef; font-weight: 600;">
                                    <tr>
                                        <th class="text-left" style="padding: 8px;">Description</th>
                                        <th class="text-right" style="padding: 8px; width: 25%;">Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 8px;">Total Accrued Annual Leave</td>
                                        <td class="text-right" style="padding: 8px;"><t t-esc="'%.2f' % o.accrued_annual_leaves"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px;">Total Utilized Annual Leave</td>
                                        <td class="text-right" style="padding: 8px;"><t t-esc="'%.2f' % o.utilized_annual_leaves"/></td>
                                    </tr>
                                    <tr style="background-color: #f1f8ff; font-weight: bold;">
                                        <td style="padding: 8px;">Remaining Annual Leave Balance</td>
                                        <td class="text-right" style="padding: 8px; color: #0056b3;"><t t-esc="'%.2f' % o.remaining_annual_leaves"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Monetary Valuation Table -->
                        <div class="mb-4">
                            <h6 style="font-weight: 700; border-bottom: 2px solid #0056b3; padding-bottom: 4px; color: #0056b3;">2. Monetary Valuation (in Birr)</h6>
                            <table class="table table-bordered table-sm mt-2" style="width: 100%; border-collapse: collapse;">
                                <thead style="background-color: #e9ecef; font-weight: 600;">
                                    <tr>
                                        <th class="text-left" style="padding: 8px;">Component</th>
                                        <th class="text-right" style="padding: 8px; width: 25%;">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 8px;">Monthly Basic Salary</td>
                                        <td class="text-right" style="padding: 8px;">
                                            <t t-if="o.contract_id and o.contract_id.wage">
                                                <span t-esc="'{:,.2f}'.format(o.contract_id.wage)"/> ETB
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px;">Daily Wage Rate (Divisor: <t t-esc="'%.0f' % (o.company_id.leave_encashment_divisor or 26)"/> days)</td>
                                        <td class="text-right" style="padding: 8px;">
                                            <span t-esc="'{:,.2f}'.format(o.daily_wage_rate)"/> ETB
                                        </td>
                                    </tr>
                                    <tr style="background-color: #e8f5e9; font-weight: bold; font-size: 14px;">
                                        <td style="padding: 8px; color: #2e7d32;">Total Payable Leave Encashment Value</td>
                                        <td class="text-right" style="padding: 8px; color: #2e7d32;">
                                            <span t-esc="'{:,.2f}'.format(o.annual_leave_monetary_value)"/> ETB
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Signatures Box -->
                        <div class="mt-5 pt-4">
                            <table style="width: 100%; margin-top: 40px; border: none;">
                                <tr>
                                    <td style="width: 33%; text-align: center; border: none;">
                                        <div style="border-top: 1px solid #333; width: 80%; margin: 0 auto; padding-top: 5px;">
                                            <strong>Prepared By</strong><br/>
                                            <span style="font-size: 11px; color: #666;">HR Officer</span>
                                        </div>
                                    </td>
                                    <td style="width: 33%; text-align: center; border: none;">
                                        <div style="border-top: 1px solid #333; width: 80%; margin: 0 auto; padding-top: 5px;">
                                            <strong>Verified By</strong><br/>
                                            <span style="font-size: 11px; color: #666;">Immediate Supervisor</span>
                                        </div>
                                    </td>
                                    <td style="width: 33%; text-align: center; border: none;">
                                        <div style="border-top: 1px solid #333; width: 80%; margin: 0 auto; padding-top: 5px;">
                                            <strong>Approved By</strong><br/>
                                            <span style="font-size: 11px; color: #666;">HR Director</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
