<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Leave Postponement -->
        <record id="seq_hr_leave_postponement" model="ir.sequence">
            <field name="name">Leave Postponement</field>
            <field name="code">hr.leave.postponement</field>
            <field name="prefix">POST/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Leave Schedule -->
        <record id="seq_hr_leave_schedule" model="ir.sequence">
            <field name="name">Leave Schedule</field>
            <field name="code">hr.leave.schedule</field>
            <field name="prefix">ALS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
