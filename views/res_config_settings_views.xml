<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ethswitch" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ethswitch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Time Off" string="Time Off" name="hr_holidays" groups="hr_holidays.group_hr_holidays_manager">
                    <block title="EthSwitch Leave Policies &amp; Fiscal Year" name="ethswitch_policies_setting_block">
                        <setting id="fiscal_year_setting" title="Ethiopian Fiscal Year" help="Define the starting date for the Ethiopian budget year (Hamle 1 / July 8).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fiscal_year_start_month" class="col-lg-4 o_light_label"/>
                                    <field name="fiscal_year_start_month" class="col-lg-6"/>
                                </div>
                                <div class="row mt8">
                                    <label for="fiscal_year_start_day" class="col-lg-4 o_light_label"/>
                                    <field name="fiscal_year_start_day" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="encashment_divisor_setting" title="Leave Encashment Divisor" help="Divisor applied to monthly basic salary to determine daily wage rate for unused leave valuation in Birr.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="leave_encashment_divisor" class="col-lg-4 o_light_label"/>
                                    <field name="leave_encashment_divisor" class="col-lg-4"/>
                                    <span class="col-lg-4 text-muted">days/month</span>
                                </div>
                            </div>
                        </setting>
                        <setting id="expiry_warning_setting" title="Leave Expiry Warning Notice" help="Advance notification period before accumulated leave is expired after the two-year limit.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="leave_expiry_warning_days" class="col-lg-4 o_light_label"/>
                                    <field name="leave_expiry_warning_days" class="col-lg-4"/>
                                    <span class="col-lg-4 text-muted">days before year-end</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
