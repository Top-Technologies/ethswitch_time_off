<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Postponement Record Rules -->
        <record id="rule_hr_leave_postponement_user" model="ir.rule">
            <field name="name">Leave Postponement: Employee &amp; Manager</field>
            <field name="model_id" ref="model_hr_leave_postponement"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hr_leave_postponement_officer" model="ir.rule">
            <field name="name">Leave Postponement: Time Off Officer All</field>
            <field name="model_id" ref="model_hr_leave_postponement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <!-- Schedule Record Rules -->
        <record id="rule_hr_leave_schedule_user" model="ir.rule">
            <field name="name">Leave Schedule: Employee &amp; Manager</field>
            <field name="model_id" ref="model_hr_leave_schedule"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hr_leave_schedule_officer" model="ir.rule">
            <field name="name">Leave Schedule: Time Off Officer All</field>
            <field name="model_id" ref="model_hr_leave_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <!-- Schedule Line Record Rules -->
        <record id="rule_hr_leave_schedule_line_user" model="ir.rule">
            <field name="name">Leave Schedule Line: Employee &amp; Manager</field>
            <field name="model_id" ref="model_hr_leave_schedule_line"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hr_leave_schedule_line_officer" model="ir.rule">
            <field name="name">Leave Schedule Line: Time Off Officer All</field>
            <field name="model_id" ref="model_hr_leave_schedule_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>
    </data>
</odoo>
