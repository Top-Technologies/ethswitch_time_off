<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_reversal_wizard_form" model="ir.ui.view">
        <field name="name">hr.leave.reversal.wizard.form</field>
        <field name="model">hr.leave.reversal.wizard</field>
        <field name="arch" type="xml">
            <form string="Annual Leave Reversal (Hospitalization)">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>Policy Note:</strong> This reversal converts approved annual leave days into Sick Leave due to documented hospitalization or medical treatment, restoring the corresponding annual leave days to the employee.
                    </div>
                    <group>
                        <group string="Original Leave">
                            <field name="leave_id" readonly="1" options="{'no_open': True}"/>
                            <field name="employee_id" readonly="1"/>
                            <label for="leave_date_from" string="Leave Period"/>
                            <div class="o_row">
                                <field name="leave_date_from"/>
                                <span class="oe_grey"> to </span>
                                <field name="leave_date_to"/>
                            </div>
                        </group>
                        <group string="Hospitalization Details">
                            <label for="reversal_date_from" string="Hospitalization Period"/>
                            <div class="o_row">
                                <field name="reversal_date_from"/>
                                <span class="oe_grey"> to </span>
                                <field name="reversal_date_to"/>
                            </div>
                            <field name="days_to_reverse"/>
                        </group>
                    </group>
                    <group string="Medical Justification &amp; Documentation">
                        <field name="reason" placeholder="State the medical condition or reason for hospitalization..."/>
                        <field name="certificate_filename" invisible="1"/>
                        <field name="medical_certificate" filename="certificate_filename" widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reversal" string="Approve Reversal &amp; Convert" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_reversal_wizard" model="ir.actions.act_window">
        <field name="name">Medical Reversal</field>
        <field name="res_model">hr.leave.reversal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
